# ==========================================
# Distributed Legal RAG - Environment Variables Template
# Copy to .env and fill in values
# NEVER commit .env to version control!
# ==========================================

# ------------------------------------------
# OpenAI API (Required for LLM generation)
# Get from: https://platform.openai.com/api-keys
# ------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.1

# ------------------------------------------
# Database Configuration
# ------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=legal_rag
DB_USER=rag_user
DB_PASSWORD=changeme-secure-password

# ------------------------------------------
# C++ Database Nodes (3 shards)
# ------------------------------------------
DB_SHARD_ID=0  # 0, 1, or 2 (set per container)
SERVER_PORT=8081

# ------------------------------------------
# C++ Router Configuration
# ------------------------------------------
ROUTER_PORT=8080
DB_NODES=cpp_database_0:8081,cpp_database_1:8081,cpp_database_2:8081

# ------------------------------------------
# API Gateway (FastAPI)
# ------------------------------------------
ROUTER_HOST=cpp_router
ROUTER_PORT=8080
ROUTER_POOL_SIZE=2
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------
# Data Ingestion
# ------------------------------------------
MAX_INGESTION_CHUNKS=1000
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cuda  # cuda or cpu
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# ------------------------------------------
# Frontend (Vercel)
# ------------------------------------------
VITE_API_URL=http://localhost:8000

# ------------------------------------------
# Monitoring (Local only)
# ------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------
# Production (EC2) - Set on server via GitHub Actions
# ------------------------------------------
# IMAGE_TAG=git-sha-here
# EC2_HOST=your-ec2-public-ip
# DUCKDNS_DOMAIN=nimish-legal-rag.duckdns.org
# CERTBOT_EMAIL=your-email@example.com