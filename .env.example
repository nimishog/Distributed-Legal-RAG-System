# ==========================================
# Distributed Legal RAG - Environment Variables Template
# Copy to .env and fill in values.
# NEVER commit .env to version control!
# ==========================================

# ------------------------------------------
# OpenAI (required for LLM generation)
# ------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.1

# ------------------------------------------
# API Gateway
# ------------------------------------------
ROUTER_HOST=cpp_router
ROUTER_PORT=8080
ROUTER_POOL_SIZE=2
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
RATE_LIMIT_CONCURRENT=2

# Browser origins allowed to call the gateway. In production this should be
# the Vercel origin, e.g.:
#   CORS_ORIGINS=["https://distributed-legal-rag.vercel.app"]
# Optional regex to also allow Vercel preview deployments:
#   CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=false

# Optional API key. Leave empty for an open recruiter demo.
API_KEY=

# ------------------------------------------
# Database (local development: localdev)
# ------------------------------------------
DB_HOST=postgres_0
DB_PORT=5432
DB_NAME=legal_rag
DB_USER=rag_user
DB_PASSWORD=localdev
DB_SHARD_ID=0
SERVER_PORT=8081

# ------------------------------------------
# C++ Router
# ------------------------------------------
ROUTER_HTTP_PORT=8084
DB_NODES=cpp_database_0:8081,cpp_database_1:8081,cpp_database_2:8081

# ------------------------------------------
# Data Ingestion
# ------------------------------------------
MAX_INGESTION_CHUNKS=1000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# ------------------------------------------
# Frontend (Vercel build-time variables)
# ------------------------------------------
VITE_API_URL=http://localhost:8000
# Only set if API_KEY is enabled on the gateway.
VITE_API_KEY=

# ------------------------------------------
# Monitoring (local only)
# ------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------
# Deployment (used by GitHub Actions / deploy.sh)
# ------------------------------------------
# GITHUB_REPOSITORY=your-org/distributed-legal-rag
# IMAGE_TAG=git-sha-here
# EC2_HOST=your-ec2-public-ip
# DUCKDNS_DOMAIN=nimish-legal-rag.duckdns.org
# PROJECT_DIR=/opt/legal-rag
